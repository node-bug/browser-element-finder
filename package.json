{
  "name": "@nodebug/browser-element-finder",
  "version": "1.3.8",
  "description": "Robust, agent-friendly JavaScript library for identifying DOM elements by semantic type and/or text content, with full support for shadow DOM, iframes, and browser automation workflows (Selenium, Playwright, Puppeteer).",
  "exports": {
    ".": {
      "import": "./src/element-finder.js",
      "default": "./src/element-finder.js"
    },
    "./browser": {
      "default": "./index.js"
    },
    "./min": {
      "default": "./index.min.js"
    },
    "./element-definitions.json": {
      "import": "./src/element-definitions.json",
      "default": "./src/element-definitions.json"
    },
    "./searchable-attributes.json": {
      "import": "./src/searchable-attributes.json",
      "default": "./src/searchable-attributes.json"
    }
  },
  "files": [
    "index.js",
    "index.min.js",
    "src/element-finder.js",
    "src/element-definitions.json",
    "src/searchable-attributes.json"
  ],
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "keywords": [
    "selenium",
    "webdriver",
    "element-finder",
    "browser-automation",
    "testing"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/node-bug/browser-element-finder.git"
  },
  "homepage": "https://github.com/node-bug/browser-element-finder#readme",
  "bugs": {
    "url": "https://github.com/node-bug/browser-element-finder/issues"
  },
  "scripts": {
    "build": "node scripts/build.js",
    "prepack": "npm run build",
    "lint": "eslint .",
    "test": "npm run build && vitest run",
    "test:watch": "npm run build && vitest",
    "test:coverage": "npm run build && vitest run --coverage",
    "prepare": "husky && echo 'npx lint-staged' > .husky/pre-commit && chmod +x .husky/pre-commit"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@vitest/coverage-v8": "^4.1.10",
    "esbuild": "^0.28.1",
    "eslint": "^10.8.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.8.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.2.0",
    "prettier": "^3.9.6",
    "selenium-webdriver": "^4.46.0",
    "vitest": "^4.1.10"
  },
  "lint-staged": {
    "*.js": [
      "eslint --fix"
    ],
    "*.{json,yaml,yml,md,sh,groovy}": [
      "prettier --write"
    ]
  },
  "license": "MIT"
}

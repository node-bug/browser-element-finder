{
  "name": "@nodebug/browser-element-finder",
  "version": "1.1.1",
  "description": "Browser Element Finder - Find elements by type and text content",
  "main": "index.js",
  "browser": "index.js",
  "exports": {
    ".": {
      "browser": "./index.js",
      "require": "./index.js",
      "import": "./index.js"
    },
    "./element-definitions.json": {
      "browser": "./src/element-definitions.json",
      "require": "./src/element-definitions.json",
      "import": "./src/element-definitions.json",
      "default": "./src/element-definitions.json"
    },
    "./searchable-attributes.json": {
      "browser": "./src/searchable-attributes.json",
      "require": "./src/searchable-attributes.json",
      "import": "./src/searchable-attributes.json",
      "default": "./src/searchable-attributes.json"
    }
  },
  "files": [
    "index.js",
    "src/element-definitions.json",
    "src/searchable-attributes.json"
  ],
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "keywords": [
    "selenium",
    "webdriver",
    "element-finder",
    "browser-automation",
    "testing"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/node-bug/browser-element-finder.git"
  },
  "homepage": "https://github.com/node-bug/browser-element-finder#readme",
  "bugs": {
    "url": "https://github.com/node-bug/browser-element-finder/issues"
  },
  "scripts": {
    "build": "node build.js",
    "lint": "eslint .",
    "test": "npm run build && vitest run",
    "test:watch": "npm run build && vitest",
    "test:coverage": "npm run build && vitest run --coverage",
    "prepare": "husky && echo 'npx lint-staged' > .husky/pre-commit && chmod +x .husky/pre-commit"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@vitest/coverage-v8": "^3.2.4",
    "esbuild": "^0.28.0",
    "eslint": "^10.2.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.5.0",
    "husky": "^9.1.7",
    "jsdom": "^29.1.1",
    "lint-staged": "^16.4.0",
    "prettier": "^3.8.2",
    "selenium-webdriver": "^4.43.0",
    "vitest": "^3.0.0"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx}": [
      "eslint --fix"
    ],
    "*.{json,yaml,yml,md,sh,groovy}": [
      "prettier --write"
    ]
  },
  "license": "MIT"
}

{
  "name": "@nodebug/browser-element-finder",
  "version": "1.0.3",
  "description": "Browser Element Finder - Find elements by type and text content",
  "main": "src/element-finder.js",
  "browser": "index.js",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "keywords": [
    "selenium",
    "webdriver",
    "element-finder",
    "browser-automation",
    "testing"
  ],
  "scripts": {
    "build": "node build.js",
    "lint": "eslint .",
    "test": "npm run build && vitest run",
    "test:watch": "npm run build && vitest",
    "test:coverage": "npm run build && vitest run --coverage",
    "prepare": "husky && echo 'npx lint-staged' > .husky/pre-commit && chmod +x .husky/pre-commit"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@vitest/coverage-v8": "^3.2.4",
    "eslint": "^10.2.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.5.0",
    "husky": "^9.1.7",
    "jsdom": "^29.1.1",
    "lint-staged": "^16.4.0",
    "nyc": "^18.0.0",
    "prettier": "^3.8.2",
    "selenium-webdriver": "^4.43.0",
    "terser": "^5.47.1",
    "vitest": "^3.0.0"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx}": [
      "eslint --fix"
    ],
    "*.{json,yaml,yml,md,sh,groovy}": [
      "prettier --write"
    ]
  }
}

{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "vitest",
      "type": "node",
      "request": "launch",
      "console": "integratedTerminal",
      "program": "${workspaceFolder}/node_modules/vitest/vitest.mjs",
      "args": ["run", "${workspaceFolder}/tests/integration/tables.test.js"],
      "autoAttachChildProcesses": true
    },
    {
      "name": "vitest - textbox test",
      "type": "node",
      "request": "launch",
      "console": "integratedTerminal",
      "program": "${workspaceFolder}/node_modules/vitest/vitest.mjs",
      "args": [
        "run",
        "${workspaceFolder}/tests/integration/switches.test.js",
        "-t",
        "should return bounding box info for main frame switches"
      ],
      "autoAttachChildProcesses": true
    }
  ]
}
